# Keep the Gradle wrapper in source control so Android builds work on a clean
# checkout without requiring a locally installed Gradle distribution.
!gradle-wrapper.jar
/.gradle
/captures/
!/gradlew
!/gradlew.bat
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
